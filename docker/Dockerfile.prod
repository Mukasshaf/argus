FROM php:8.3-fpm-alpine

RUN apk add --no-cache \
    git \
    curl \
    libzip-dev \
    libxml2-dev \
    oniguruma-dev \
    mysql-client \
    nginx \
    supervisor \
    && docker-php-ext-install pdo_mysql mbstring xml zip pcntl bcmath opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY core/composer.json core/composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader || true

COPY core/ .
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

COPY docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["sh", "-c", "php artisan config:cache && php artisan route:cache && php artisan view:cache && php-fpm -D && nginx -g 'daemon off;'"]
