APP_NAME=OTASimulator
APP_ENV=local
APP_KEY=base64:uJbK063bNqC6bKz4+JbK063bNqB=
APP_DEBUG=true
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_LEVEL=debug

# The simulator owns only the three sim_* tables, so the database session and
# cache drivers that Laravel defaults to are unavailable here.
DB_CONNECTION=sqlite
DB_DATABASE=database/otasim.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
CACHE_PREFIX=argus_otasim_cache

# Where the simulator posts inbound bookings and webhooks.
CORE_BASE_URL=http://app:8000

# Shared CSV drop folder for the Mela Bulk channel.
MELA_STORAGE_PATH=/shared/sftp

# Must match the secrets configured on the core channels.
RAAHI_WEBHOOK_SECRET=s3cr3t-raahi-webhook
SARAI_WEBHOOK_SECRET=s3cr3t-sarai-webhook
MELA_WEBHOOK_SECRET=s3cr3t-mela-webhook
